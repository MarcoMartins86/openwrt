#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "tplink,tl-wpa7510-v2", "ralink,mt7620a-soc";
	model = "TP-Link TL-WPA7510 v2";

	aliases {
		label-mac-device = &ethernet;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		pair {
			label = "pair";
			gpios = <&gpio2 27 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
			debounce-interval = <60>;
		};

		led {
			label = "led";
			gpios = <&gpio2 28 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_LIGHTS_TOGGLE>;
			debounce-interval = <60>;
		};

		wifi {
			label = "wifi";
			gpios = <&gpio2 29 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio2 22 GPIO_ACTIVE_LOW>;
		};

		wlan5g {
			function = LED_FUNCTION_WLAN_5GHZ;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio2 26 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		wlan2g {
			function = LED_FUNCTION_WLAN_2GHZ;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio2 30 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
		};
	};

	gpio-export {
		compatible = "gpio-export";

		led_control {
			gpio-export,name = "tp-link:led:control";
			gpio-export,output = <0>;
			gpios = <&gpio2 20 GPIO_ACTIVE_LOW>;
		};
	};
};

&gpio2 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <30000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "factory-uboot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot";
				reg = <0x30000 0x30000>;
				read-only;
			};

			partition@60000 {
				compatible = "tplink,firmware";
				label = "firmware";
				reg = <0x60000 0x5d0000>;
			};

			partition@630000 {
				label = "config";
				reg = <0x630000 0x60000>;
				read-only;
			};

			/* the powerline chip has no flash, the host loads these into it */
			partition@690000 {
				label = "plc-fw";
				reg = <0x690000 0x100000>;
				read-only;
			};

			partition@790000 {
				label = "plc-bin";
				reg = <0x790000 0x20000>;
				read-only;
			};

			partition@7b0000 {
				label = "plc-param";
				reg = <0x7b0000 0x10000>;
				read-only;
			};

			partition@7c0000 {
				label = "plc-param-csv";
				reg = <0x7c0000 0x10000>;
				read-only;
			};

			partition@7d0000 {
				label = "default-param";
				reg = <0x7d0000 0x10000>;
				read-only;
			};

			partition@7e0000 {
				label = "info";
				reg = <0x7e0000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_info_108: macaddr@108 {
						compatible = "mac-base";
						reg = <0x108 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@7f0000 {
				label = "radio";
				reg = <0x7f0000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_radio_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					eeprom_radio_8000: eeprom@8000 {
						reg = <0x8000 0x200>;
					};
				};
			};
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "uartf", "mdio", "rgmii2", "wled", "nd_sd";
		function = "gpio";
	};
};

/* the port leads to the powerline chip, which has the socket behind it */
&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins>;

	nvmem-cells = <&macaddr_info_108 0>;
	nvmem-cell-names = "mac-address";

	port@5 {
		status = "okay";
		mediatek,fixed-link = <1000 1 1 1>;
		phy-mode = "rgmii";
	};
};

&wmac {
	pinctrl-names = "default", "pa_gpio";
	pinctrl-0 = <&pa_pins>;
	pinctrl-1 = <&pa_gpio_pins>;

	nvmem-cells = <&eeprom_radio_0>, <&macaddr_info_108 0>;
	nvmem-cell-names = "eeprom", "mac-address";
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		ieee80211-freq-limit = <5000000 6000000>;
		nvmem-cells = <&eeprom_radio_8000>, <&macaddr_info_108 1>;
		nvmem-cell-names = "eeprom", "mac-address";
	};
};
